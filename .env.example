# Connection string — use env / user-secrets, never commit real credentials.
# ConnectionStrings__Default=Host=…;Database=…;Username=…;Password=…;SSL Mode=Require
ConnectionStrings__Default=

# JWT (dev only)
Jwt__SigningKey=DEV_ONLY_CHANGE_ME_almat_mlm_skeleton_signing_key_32+
Jwt__Issuer=almat-mlm-api
Jwt__Audience=almat-mlm-web

# TickerQ dashboard (required — must not be public)
TickerQ__Dashboard__Username=admin
TickerQ__Dashboard__Password=change-me-tickerq-dashboard

# CORS
Cors__Origins__0=http://localhost:3000
