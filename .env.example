# Connection string — use env / user-secrets, never commit real credentials.
# ConnectionStrings__Default=Host=…;Database=…;Username=…;Password=…;SSL Mode=Require
ConnectionStrings__Default=

# JWT (dev only)
Jwt__SigningKey=DEV_ONLY_CHANGE_ME_mlm_skeleton_signing_key_32+
Jwt__Issuer=mlm-api
Jwt__Audience=mlm-web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# Quartz.Dashboard (required — policy QuartzDashboard / Basic; must not be public)
Quartz__Dashboard__Username=admin
Quartz__Dashboard__Password=change-me-quartz-dashboard

# CORS
Cors__Origins__0=http://localhost:3000
